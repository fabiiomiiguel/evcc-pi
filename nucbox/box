#!/usr/bin/env bash
# devbox: runs "$@" in the LXD container `dev` (DEVBOX_INSTANCE) as fabio in the current directory (same paths both
# sides). Dogchef folders only, by claude-wrap's rule; everything else runs on the host.
. "$(dirname "$(realpath "$0")")/is-business-dir.sh" || { echo "box: is-business-dir.sh missing next to $0" >&2; exit 70; }
[[ $(basename "$0") == devbox ]] || { echo "box: call it as devbox" >&2; exit 64; }
is_business_dir "$PWD" || { echo "devbox runs dogchef folders only: $PWD is not one, run it on the host" >&2; exit 2; }
exec lxc exec "${DEVBOX_INSTANCE:-dev}" --cwd "$PWD" -- sudo -u fabio -H bash -lc 'cd "$0" && export GRAPHIFY_SKIP_HOOK=1 && exec "$@"' "$PWD" "$@"
