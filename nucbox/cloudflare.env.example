# /etc/caddy/cloudflare.env (root:root, 0600): the environment of caddy.service.
# CLOUDFLARE_API_TOKEN: a token with Zone:DNS:Edit on the zone, for the ACME DNS challenge.
# AUTHP_SHARED_KEY (caddy-security's token key) is appended by caddy-install.sh; never copy it anywhere.
CLOUDFLARE_API_TOKEN=
