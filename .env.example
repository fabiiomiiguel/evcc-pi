# Copy to .env and fill in. .env is in .gitignore — it never reaches git.
#
#     cp .env.example .env && chmod 600 .env
#
# Used by setup-pi.py, deploy.py and evcc-fix.py.

# --- access to the Pi (deploy.py, evcc-fix.py) ---
PI="admin@raspberrypi.home.arpa"

# --- network / system (setup-pi.py) ---
NEW_HOSTNAME="raspberrypi"
TIMEZONE="Europe/Lisbon"
LOCAL_DOMAIN="home.arpa"        # RFC 8375, the default domain for home networks
CADDY_EMAIL="admin@example.com" # Caddy's ACME/Let's Encrypt email

# --- Pi-hole ---
PIHOLE_WEB_PORT_HTTP="8080"
PIHOLE_WEB_PORT_HTTPS="8443"
PIHOLE_DNS_1="1.1.1.1"
PIHOLE_DNS_2="1.0.0.1"
PIHOLE_PASSWORD=""              # empty = generate a random one and print it

# --- Tailscale ---
TS_AUTHKEY=""                   # optional; empty = interactive browser login

# --- evcc: hardware ---
EVCC_SPONSOR_TOKEN=""           # https://sponsor.evcc.io (needed for the Pulsar Plus)
WALLBOX_STATION_ID=""           # Charge Point Identity, from the myWallbox app
EMMA_HOST=""                    # Huawei EMMA IP (with Modbus TCP enabled)
BATTERY_CAPACITY="5"            # home battery, kWh

# --- vehicle ---
EV_USER=""                      # MyPeugeot account email
EV_VIN=""                       # vehicle VIN

# --- evcc control loop ---
# Shifts the control zero-point. Must stay above the meter's noise floor:
# measured ~55 W peak-to-peak on a Huawei EMMA, so the 100 W the web UI
# suggests is too low there. Note the web UI value overrides the yaml.
RESIDUAL_POWER="150"

# --- tariff (EUR/kWh, incl. VAT) ---
TARIFF_OFF_PEAK="0.14"          # off-peak, 22:00-08:00
TARIFF_PEAK="0.22"              # peak
